            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LocationChange": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "storeId": {
            "type": "integer",
            "title": "Storeid"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "accuracyM": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracym"
          },
          "source": {
            "type": "string",
            "enum": [
              "gps",
              "map"
            ],
            "title": "Source"
          },
          "previousLatitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previouslatitude"
          },
          "previousLongitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previouslongitude"
          },
          "createdAt": {
            "type": "string",
            "title": "Createdat"
          }
