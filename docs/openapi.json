  "components": {
    "schemas": {
      "AccessRequest": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password"
        ],
        "title": "AccessRequest"
      },
      "AccessResponse": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "expiresAt": {
            "type": "string",
            "title": "Expiresat"
          }
        },
        "type": "object",
        "required": [
          "token",
          "expiresAt"
        ],
        "title": "AccessResponse"
      },
      "Backup": {
        "properties": {
          "format": {
            "type": "string",
            "const": "olocation-backup",
            "title": "Format"
          },
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version"
          },
          "exportedAt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Exportedat"
          },
          "stores": {
            "items": {
              "$ref": "#/components/schemas/BackupStore"
            },
            "type": "array",
            "title": "Stores"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "format",
          "version",
          "stores"
        ],
        "title": "Backup",
        "description": "Respaldo completo: todas las tiendas con su historial. Se identifica a cada tienda por `code`."
      },
      "BackupChange": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "accuracyM": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracym"
          },
          "source": {
            "type": "string",
            "enum": [
              "gps",
              "map"
            ],
            "title": "Source"
          },
          "previousLatitude": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Previouslatitude"
          },
          "previousLongitude": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Previouslongitude"
          },
          "createdAt": {
            "type": "string",
            "maxLength": 40,
            "title": "Createdat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "source",
          "createdAt"
        ],
        "title": "BackupChange"
      },
      "BackupStore": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Code"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "locationUpdatedAt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Locationupdatedat"
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Createdat"
          },
          "changes": {
            "items": {
              "$ref": "#/components/schemas/BackupChange"
            },
            "type": "array",
            "title": "Changes",
            "description": "Más reciente primero"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "title": "BackupStore"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
