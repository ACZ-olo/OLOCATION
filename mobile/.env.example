# Copiar a mobile/.env (no se sube al repositorio). Vite incluye estos valores en la app al compilar:
# NO poner aquí secretos de servidor (la anon key de Supabase sí es pública por diseño).

# De dónde salen los datos: "api" (backend FastAPI de backend/) o "supabase".
VITE_DATA_PROVIDER=api

# --- Proveedor "api" ---------------------------------------------------------
# URL del backend para la app instalada en Android (APK). En el navegador se usa la misma
# dirección desde la que se abrió la app, así que esto no hace falta para probar en el PC.
#   Teléfono físico en la misma Wi‑Fi:  http://<IP-del-PC>:8000
#   Emulador de Android Studio:          http://10.0.2.2:8000
#   Servidor publicado:                  https://<dominio>
VITE_API_URL=http://192.168.1.50:8000

# --- Proveedor "supabase" (preparado, todavía no en uso) ----------------------
# Project Settings → API en el panel de Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
