# Copiar a backend/.env (no se sube al repositorio) y ajustar.

# Contraseña general para entrar a la app. Obligatoria: sin ella nadie puede entrar.
# Al cambiarla, todos los dispositivos recordados tienen que volver a ingresarla.
OLOCATION_ACCESS_PASSWORD=cambiar-esta-clave

# Secreto extra para firmar los tokens de acceso (texto largo y aleatorio).
# Cambiarlo también obliga a todos a ingresar la contraseña de nuevo.
OLOCATION_TOKEN_SECRET=

# Ruta del archivo SQLite (relativa a backend/ o absoluta)
OLOCATION_DB_PATH=data/olocation-v2.db

# Orígenes permitidos para llamar a la API (CORS), separados por coma.
# Por defecto: la app Android (https://localhost) y Vite en desarrollo (http://localhost:5173).
# OLOCATION_CORS_ORIGINS=https://localhost,http://localhost,capacitor://localhost,http://localhost:5173
